# Copia questo file in `.env` (stessa cartella) e compila. Il file .env NON
# va su GitHub: contiene la chiave segreta e la password delle email.

# L'indirizzo dell'app, senza https:// e senza www (es. reformerpilates.it)
DOMINIO=reformerpilates.it

# Lo stesso, completo: serve ai link nelle email
REFORMER_URL_PUBBLICO=https://reformerpilates.it

# Chiave segreta: generala UNA volta sul server con
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# e incollala qui. Tienine una copia al sicuro (gestore di password).
REFORMER_SECRET_KEY=

# Le email di Greta ed Elisa: chi si registra con questi indirizzi e conferma
# la mail diventa staff da sola.
REFORMER_EMAIL_STAFF=greta.lorenzetti@icloud.com,elisabonacci@yahoo.it

# --- Email (Gmail con "password per le app", vedi MESSA-ONLINE.md) ---------
REFORMER_EMAIL_SMTP_HOST=smtp.gmail.com
REFORMER_EMAIL_SMTP_PORTA=587
REFORMER_EMAIL_SMTP_UTENTE=reformerstudio@gmail.com
# 16 lettere date da Google, senza spazi. NON la password normale di Gmail.
REFORMER_EMAIL_SMTP_PASSWORD=
REFORMER_EMAIL_MITTENTE=RE FORMER <reformerstudio@gmail.com>

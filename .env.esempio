# Copia questo file in `.env` (stessa cartella) e compila i valori.
# Il file `.env` non finisce su GitHub: contiene password.
#
#     cp .env.esempio .env
#
# Dopo averlo compilato:  python -m scripts.prova_email tua@email.it

# --- Posta ------------------------------------------------------------------
# Finché EMAIL_SMTP_HOST è vuoto le email NON partono: finiscono nel log del
# server con il link in chiaro. Va benissimo per provare da soli.

# Con Gmail: host e porta sono questi, non si cambiano.
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORTA=587

# L'indirizzo Gmail per intero.
EMAIL_SMTP_UTENTE=tuonome@gmail.com

# NON la password del tuo account: la "password per le app", 16 lettere.
# Si crea su https://myaccount.google.com/apppasswords dopo aver attivato la
# verifica in due passaggi. Qui si scrive senza spazi.
EMAIL_SMTP_PASSWORD=abcdefghijklmnop

# Come appare il mittente. L'indirizzo dev'essere lo stesso di sopra: Gmail
# riscrive comunque il proprio, e gli altri server rifiutano.
EMAIL_MITTENTE=Guardlink <tuonome@gmail.com>

# --- Indirizzo dell'app -----------------------------------------------------
# Ci finiscono dentro i link delle email. Finché l'app gira solo sul tuo
# computer, i link funzionano solo sul tuo computer.
URL_PUBBLICO=http://127.0.0.1:8000

# ============================================================================
#  Da qui in giù: solo quando l'app va su un server vero.
#  Con URL_PUBBLICO in https l'app fa dei controlli all'avvio e si RIFIUTA di
#  partire se qualcosa non è a posto — dicendoti cosa. È voluto: un server
#  acceso male funziona benissimo e sembra a posto.
# ============================================================================

# Il dominio, senza https:// davanti. Lo legge Caddy per chiedere il
# certificato. Deve già puntare all'IP del server.
# DOMINIO=guardlink.it

# La chiave con cui si firmano gli accessi.
# Generala con: python -c "import secrets; print(secrets.token_hex(32))"
# Quella predefinita sta scritta nel codice su GitHub: online non si usa.
# Cambiandola, tutti gli accessi già fatti vanno rifatti.
# SECRET_KEY=

# --- Database ---------------------------------------------------------------
# Si parte con SQLite e va benissimo. Per PostgreSQL serve anche aggiungere
# psycopg[binary] a requirements.txt, e travasare i dati.
# DATABASE_URL=postgresql+psycopg://utente:password@host/guardlink

# ============================================================================
#  Piscina Comunale di Ciampino (cartella piscina/)
#  È un'app a sé: le sue variabili hanno tutte il prefisso PISCINA_, così i
#  due progetti possono stare nello stesso file senza pestarsi i piedi.
# ============================================================================

# --- Dove arrivano le prenotazioni ------------------------------------------
# QUESTA è la riga che collega il modulo del cliente al banco della cassa:
# a ogni prenotazione parte un'email con nome, telefono ed email di chi ha
# prenotato. Più indirizzi si separano con la virgola.
PISCINA_EMAIL_STAFF=cassa@lapiscina.it

# La posta in uscita della piscina (le stesse istruzioni di sopra per Gmail).
PISCINA_EMAIL_SMTP_HOST=smtp.gmail.com
PISCINA_EMAIL_SMTP_PORTA=587
PISCINA_EMAIL_SMTP_UTENTE=piscina@gmail.com
PISCINA_EMAIL_SMTP_PASSWORD=abcdefghijklmnop
PISCINA_EMAIL_MITTENTE=Piscina di Ciampino <piscina@gmail.com>

# Indirizzo pubblico dell'app: ci finisce nei link delle email.
PISCINA_URL_PUBBLICO=http://127.0.0.1:8001

# La chiave che firma gli accessi dello staff.
# Generala con: python -c "import secrets; print(secrets.token_hex(32))"
# PISCINA_SECRET_KEY=

# --- Stagione e regole ------------------------------------------------------
# Fuori da queste date non si prenota. Lasciandole vuote non c'è limite.
# PISCINA_STAGIONE_INIZIO=2026-06-01
# PISCINA_STAGIONE_FINE=2026-09-13

# Quanti giorni avanti si può prenotare.
# PISCINA_GIORNI_PRENOTABILI=30

# Quante postazioni può prendere una prenotazione sola.
# PISCINA_MAX_POSTAZIONI_PER_PRENOTAZIONE=4

# Sconto sul noleggio per mattina e pomeriggio: 0 = si paga come la giornata
# intera (è così sul cartello di quest'anno), 0.3 = 30% di sconto.
# PISCINA_SCONTO_MEZZA_GIORNATA=0
